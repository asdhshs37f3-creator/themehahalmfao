		Font = Enum.Font.Code,
		TextSize = 11,
		Visible = false
	})

	local distLabel = createInstance("TextLabel", {
		Name = "DistLabel",
		Parent = container,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		TextStrokeTransparency = 0,
		TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
		Font = Enum.Font.Code,
		TextSize = 11,
		Visible = false
	})

	local weaponLabel = createInstance("TextLabel", {
		Name = "WeaponLabel",
		Parent = container,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		TextStrokeTransparency = 0,
		TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
		Font = Enum.Font.Code,
		TextSize = 11,
