-- Audio Player & Audio Visualizer System
local AudioGui, AudioMainFrame, AudioTrackLabel, AudioStatusLabel, AudioTimeLabel, AudioSoundInput, AudioVisualizerContainer
local AudioPlayBtn, AudioPauseBtn, AudioStopBtn, AudioLoopBtn
local audioUpdateConnection

local SoundService = game:GetService("SoundService")
local audioSound = Instance.new("Sound")
audioSound.Name = "GlitterAudioPlayerSound"
audioSound.Volume = state.audio.volume
audioSound.PlaybackSpeed = state.audio.pitch
audioSound.Looped = state.audio.looped
audioSound.Parent = SoundService
state.audio.soundObj = audioSound

function utils.updateAudioGUIStatus()
	if AudioTrackLabel then
		AudioTrackLabel.Text = state.audio.trackName or ("ID: " .. state.audio.soundId)
	end
	if AudioStatusLabel then
		if state.audio.isPlaying then
			AudioStatusLabel.Text = "▶ Playing"
			AudioStatusLabel.TextColor3 = Color3.fromRGB(80, 230, 120)
		elseif state.audio.isPaused then
			AudioStatusLabel.Text = "⏸ Paused"
			AudioStatusLabel.TextColor3 = Color3.fromRGB(240, 200, 80)
		else
			AudioStatusLabel.Text = "⏹ Stopped"
			AudioStatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
		end
	end
end

local getasset = getcustomasset or getsynasset or customasset or (function(f) return f end)

function utils.playAudio(idOrPath, name)
	if not idOrPath or idOrPath == "" then return end
	local str = tostring(idOrPath):gsub('"', ''):gsub("'", "")
	local assetUri = ""

	if str:find("%.mp3$") or str:find("%.wav$") or str:find("%.ogg$") or (isfile and pcall(isfile, str) and isfile(str)) then
		if getcustomasset or getsynasset or customasset then
			local success, result = pcall(getasset, str)
			if success and result then
				assetUri = result
			else
				assetUri = str
			end
		else
			assetUri = str
		end
		state.audio.trackName = name or (str:match("[^/\\]+$") or str)
	elseif str:match("^%d+$") then
		assetUri = "rbxassetid://" .. str
		state.audio.trackName = name or ("ID: " .. str)
	else
		assetUri = str
		state.audio.trackName = name or str
	end

	state.audio.soundId = str

	audioSound:Stop()
	audioSound.SoundId = assetUri
	audioSound.Volume = state.audio.volume
	audioSound.PlaybackSpeed = state.audio.pitch
	audioSound.Looped = state.audio.looped
	audioSound:Play()

	state.audio.isPlaying = true
	state.audio.isPaused = false
	utils.updateAudioGUIStatus()
end

function utils.pauseAudio()
	if audioSound and state.audio.isPlaying then
		audioSound:Pause()
		state.audio.isPlaying = false
		state.audio.isPaused = true
		utils.updateAudioGUIStatus()
	end
end

function utils.resumeAudio()
	if audioSound and state.audio.isPaused then
		audioSound:Resume()
		state.audio.isPlaying = true
		state.audio.isPaused = false
		utils.updateAudioGUIStatus()
	end
end

function utils.stopAudio()
	if audioSound then
		audioSound:Stop()
		state.audio.isPlaying = false
		state.audio.isPaused = false
		utils.updateAudioGUIStatus()
	end
end

function utils.setAudioVolume(vol)
	state.audio.volume = vol
	if audioSound then
		audioSound.Volume = vol
	end
end

function utils.setAudioPitch(pitch)
	state.audio.pitch = pitch
	if audioSound then
		audioSound.PlaybackSpeed = pitch
	end
end

function utils.setAudioLooped(looped)
	state.audio.looped = looped
	if audioSound then
		audioSound.Looped = looped
	end
	if AudioLoopBtn then
		AudioLoopBtn.TextColor3 = looped and Color3.fromRGB(0, 230, 150) or Color3.fromRGB(150, 150, 150)
	end
end

function utils.updateVisualizerColors()
	for _, barData in ipairs(state.audio.visualizerBars) do
		if barData.gradient then
			barData.gradient.Color = ColorSequence.new{
				ColorSequenceKeypoint.new(0, state.audio.visualizerColor1),
				ColorSequenceKeypoint.new(1, state.audio.visualizerColor2)
			}
		end
	end
end

