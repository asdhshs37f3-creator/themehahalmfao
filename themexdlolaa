function utils.updateAngelAuraColor()
	local auraName = state.visuals.selectedAura
	if auraName == "Starlight" or auraName == "Sakura" then
		if not state.visuals.selfAuraParticles then return end
		local seq = ColorSequence.new({ColorSequenceKeypoint.new(0, state.visuals.angelAuraColor), ColorSequenceKeypoint.new(1, state.visuals.angelAuraColor2)})
		for _, p in ipairs(state.visuals.selfAuraParticles) do
			if p and p.Parent then
				if p:IsA("ParticleEmitter") or p:IsA("Beam") or p:IsA("Trail") then
					p.Color = seq
				elseif p:IsA("PointLight") then
					p.Color = state.visuals.angelAuraColor
				end
				for _, d in ipairs(p:GetDescendants()) do
					if d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") then
						d.Color = seq
					elseif d:IsA("PointLight") then
						d.Color = state.visuals.angelAuraColor
					end
				end
			end
		end
		return
	end
	if not state.visuals.angelAuraModel then return end
	for _, obj in pairs(state.visuals.angelAuraModel:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.Color = state.visuals.angelAuraColor
			obj.Material = Enum.Material.Neon
		elseif obj:IsA("ParticleEmitter") then
			obj.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, state.visuals.angelAuraColor),
				ColorSequenceKeypoint.new(1, state.visuals.angelAuraColor2)
			})
			obj.LightEmission = 1
		elseif obj:IsA("Trail") then
			obj.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, state.visuals.angelAuraColor),
				ColorSequenceKeypoint.new(1, state.visuals.angelAuraColor2)
			})
			obj.LightEmission = 1
		elseif obj:IsA("Light") then
			obj.Color = state.visuals.angelAuraColor
		elseif obj:IsA("Beam") then
			obj.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, state.visuals.angelAuraColor),
				ColorSequenceKeypoint.new(1, state.visuals.angelAuraColor2)
			})
		elseif obj:IsA("MeshPart") then
			obj.Color = state.visuals.angelAuraColor
			obj.Material = Enum.Material.Neon
		elseif obj:IsA("SpecialMesh") then
			obj.VertexColor = Vector3.new(state.visuals.angelAuraColor.R, state.visuals.angelAuraColor.G, state.visuals.angelAuraColor.B)
		end
	end
end

