				local pName = tostring(player)
				local path = library.playerlist_data[pName]
				if path then
					path.instance:Destroy() 
					path.line:Destroy() 
				end
				library.playerlist_data[pName] = nil
				if getgenv().Whitelist then
					getgenv().Whitelist[pName] = nil
				end
			end 

			function library.prioritize(text) 
				if not library.selected_player then 
					return 
				end 

				local path = library.playerlist_data[library.selected_player]
				if not path then return end

				local name = library.selected_player
				if text == "Whitelist" then
					if getgenv().Whitelist[name] then
						getgenv().Whitelist[name] = nil
						path.priority_text.Text = "Neutral"
						path.priority_text.TextColor3 = patterns["Neutral"]
						path.priority = "Neutral"
						return
					else
						getgenv().Whitelist[name] = true
					end
					path.priority_text.Text = "Whitelisted"
					path.priority_text.TextColor3 = patterns["Whitelisted"]
					path.priority = "Whitelisted"
				else
					getgenv().Whitelist[name] = nil
					path.priority_text.Text = text
					path.priority_text.TextColor3 = patterns[text]
					path.priority = text
				end
			end 

