-- RenderStepped Loop
RunService.RenderStepped:Connect(function(dt)
	utils.updateSpeed()
	utils.updateJumpPower()
	utils.updateUnderground()

	if state.misc.mapLightingEnabled then
		Lighting.Brightness = state.misc.mapBrightness
		Lighting.Ambient = state.misc.mapAmbient
		Lighting.OutdoorAmbient = state.misc.mapOutdoorAmbient
		Lighting.ExposureCompensation = state.misc.mapExposureCompensation
		Lighting.EnvironmentDiffuseScale = state.misc.mapEnvironmentDiffuseScale
		Lighting.EnvironmentSpecularScale = state.misc.mapEnvironmentSpecularScale
	end

	if state.fov.circleEnabled and state.fov.frame then
		local mousePos = UIS:GetMouseLocation()
		state.fov.frame.Position = UDim2.fromOffset(
			mousePos.X - state.fov.size / 2,
			mousePos.Y - state.fov.size / 2
		)
		if state.fov.autoGlowRotation and state.fov.glowEnabled and state.fov.fillGradient then
			state.fov.fillGradient.Rotation = (state.fov.fillGradient.Rotation + state.fov.autoGlowRotationSpeed * dt) % 360
		end
	end

	if state.visuals.hitboxEnabled then
		utils.updateHitboxes()
	else
		utils.resetHitboxes()
	end

	if state.visuals.forcefieldEnabled then
		utils.updateForcefield()
	end

	if state.misc.crosshairEnabled and state.misc.crosshairDrawings then
		local t = tick()
		local pos = UIS:GetMouseLocation()
		local spin_angle = (t * CROSSHAIR_CFG.spin_speed) % 360
		local resize_length = (t * CROSSHAIR_CFG.resize_speed) % 180
		local length = CROSSHAIR_CFG.resize_min + _sin(_rad(resize_length)) * CROSSHAIR_CFG.resize_max
		for idx = 1, 4 do
			local base_angle = (idx - 1) * 90 + spin_angle
			local outline = state.misc.crosshairDrawings[idx]
			local inline  = state.misc.crosshairDrawings[idx + 4]
			local r = CROSSHAIR_CFG.radius
			local from_inner = pos + crosshairSolve(base_angle, r)
			local to_inner   = pos + crosshairSolve(base_angle, r + length)
			inline.Visible   = true
			inline.Color     = CROSSHAIR_CFG.color
			inline.From      = from_inner
			inline.To        = to_inner
			inline.Thickness = CROSSHAIR_CFG.width
			outline.Visible   = true
			outline.Color     = Color3.new(0, 0, 0)
			outline.From      = pos + crosshairSolve(base_angle, r - 1)
			outline.To        = pos + crosshairSolve(base_angle, r + length + 1)
			outline.Thickness = CROSSHAIR_CFG.width + 1.5
		end
	end

	if not state.camlock.toggleEnabled then
		state.camlock.enabled = false
	end

	if state.camlock.enabled and not state.camlock.target then
		state.camlock.target = utils.GetClosestPlayer()
	end

	if state.camlock.enabled and state.camlock.target then
		local shouldSwitch = false
		if state.strafe.enabled and state.strafe.autoStompEnabled then
			shouldSwitch = utils.isPlayerDead(state.camlock.target)
		else
			shouldSwitch = utils.isPlayerKnockedOut(state.camlock.target)
		end
		if shouldSwitch then
			state.camlock.target = utils.GetClosestPlayer()
		end

		if state.camlock.target and state.camlock.target.Character and state.camlock.target.Character:FindFirstChild(state.camlock.hitpart) then
			utils.addLockedHighlight(state.camlock.target)
			if state.camlock.previewHighlight then state.camlock.previewHighlight:Destroy() end

			if state.camlock.teleportEnabled then
				local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				local targetHRP = state.camlock.target.Character:FindFirstChild("HumanoidRootPart")
				if myHRP and targetHRP then
					if not state.camlock.teleporting then
						state.camlock.savedTeleportCFrame = myHRP.CFrame
						state.camlock.teleporting = true
					end
					myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, -2)
				end
			end

			Camera.CFrame = CFrame.new(Camera.CFrame.Position, state.camlock.target.Character[state.camlock.hitpart].Position)

			if state.camlock.teleportEnabled and state.camlock.teleporting and utils.isPlayerKnockedOut(state.camlock.target) then
				local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if hrp and state.camlock.savedTeleportCFrame then
					hrp.CFrame = state.camlock.savedTeleportCFrame
				end
				state.camlock.teleporting = false
				state.camlock.savedTeleportCFrame = nil
			end
		end
	else
		state.camlock.target = nil
		if state.camlock.lockedHighlight then state.camlock.lockedHighlight:Destroy() state.camlock.lockedHighlight = nil end
		if state.camlock.previewHighlight then state.camlock.previewHighlight:Destroy() state.camlock.previewHighlight = nil end
	end

	if state.camlock.enabled and state.camlock.highlightsEnabled then
		local closestPlayer = utils.GetClosestPlayer()
		if closestPlayer and closestPlayer ~= state.camlock.target then
			utils.addPreviewHighlight(closestPlayer)
		end
	end

	if state.camlock.forcehitEnabled then
		if state.camlock.forcehitAutoSwitch then
			state.camlock.forcehitTarget = utils.getForcehitTarget()
			getgenv().ForceHitTarget = state.camlock.forcehitTarget
		elseif not state.camlock.forcehitTarget then
			state.camlock.forcehitTarget = utils.getForcehitTarget()
			getgenv().ForceHitTarget = state.camlock.forcehitTarget
		end
		local fTarget = state.camlock.forcehitTarget
		if fTarget then
			if fTarget.Character and not utils.isPlayerKnockedOut(fTarget) then
				if state.camlock.teleportEnabled then
					local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					local targetHRP = fTarget.Character and fTarget.Character:FindFirstChild("HumanoidRootPart")
					if myHRP and targetHRP then
						myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, -2)
					end
				end
				utils.ShootOnTarget(fTarget)
				if not state.camlock.forcehitTracerEnabled and state.camlock.forcehitNotified ~= fTarget then
					state.camlock.forcehitNotified = fTarget
					library:notification({text = "Targetting " .. fTarget.DisplayName, time = 1.5})
				end
			elseif fTarget.Character and utils.isPlayerKnockedOut(fTarget) and state.camlock.forcehitAutoStomp then
				local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				local targetRoot = fTarget.Character and fTarget.Character:FindFirstChild("HumanoidRootPart")
				if hrp and targetRoot then
					local targetPosition = targetRoot.Position
					hrp.CFrame = CFrame.new(targetPosition.X, targetPosition.Y + 1.5, targetPosition.Z)
					local MainEvent = ReplicatedStorage:FindFirstChild("MainEvent")
					if MainEvent then
						for i = 1, 10 do
							MainEvent:FireServer("Stomp")
						end
					end
				end
			end
			utils.drawForcehitTracer(fTarget)
		else
			local lostName = state.camlock.forcehitNotified
			if lostName then
				library:notification({text = "Untargetted " .. (type(lostName) == "string" and lostName or lostName.DisplayName), time = 1.5})
			end
			state.camlock.forcehitTarget = nil
			state.camlock.forcehitNotified = nil
			utils.clearForcehitTracer()
		end
	else
		local lostName = state.camlock.forcehitNotified
		if lostName then
			library:notification({text = "Untargetted " .. (type(lostName) == "string" and lostName or lostName.DisplayName), time = 1.5})
		end
		state.camlock.forcehitTarget = nil
		state.camlock.forcehitNotified = nil
		utils.clearForcehitTracer()
	end

	-- Target Strafe
	if state.strafe.enabled and state.camlock.target and state.camlock.target.Character then
		local targetPart = state.camlock.target.Character:FindFirstChild(state.camlock.hitpart)
		local targetRoot = state.camlock.target.Character:FindFirstChild("HumanoidRootPart")
		local isGrabbed = state.camlock.target.Character:FindFirstChild("GRABBING_CONSTRAINT")

		if targetPart and targetRoot and not isGrabbed then
			local targetPosition = targetRoot.Position

			if state.strafe.autoStompEnabled and utils.isPlayerKnockedOut(state.camlock.target) and not utils.isPlayerKnockedOut(LocalPlayer) then
				LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(targetPosition.X, targetPosition.Y + 1.5, targetPosition.Z)
				local MainEvent = ReplicatedStorage:FindFirstChild("MainEvent")
				if MainEvent then
					for i = 1, 10 do
						MainEvent:FireServer("Stomp")
					end
				end
			else
				if state.strafe.predictMovementEnabled then
					targetPosition = utils.predictPosition(targetRoot, state.strafe.predictValue)
				end

				if state.strafe.mode == "Orbit" then
					local angle_val = tick() * state.strafe.speed
					local offset = Vector3.new(math.cos(angle_val) * state.strafe.xOffset, -0.1, math.sin(angle_val) * state.strafe.xOffset)
					LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(targetPosition + offset, targetPosition)
				elseif state.strafe.mode == "Random" then
					local offset = Vector3.new(math.random(-20, 20), math.random(-10, 10), math.random(-20, 20))
					local randomrotation = CFrame.Angles(
						math.rad(math.random(0, 360)),
						math.rad(math.random(0, 360)),
						math.rad(math.random(0, 360))
					)
					LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(targetPosition + offset) * randomrotation
				end
			end

			
			if state.strafe.spectateStrafeEnabled then
				workspace.CurrentCamera.CameraSubject = state.camlock.target.Character:FindFirstChild("Head")
			end
		end
	end

end)

-- Heartbeat Loop
RunService.Heartbeat:Connect(function(deltaTime)
	utils.updateCFrameSpeed(deltaTime)
	utils.updateTriggerbot()

	-- Desync
	if state.desync.enabled and LocalPlayer.Character then
		local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if rootPart then
			state.desync.old_position = rootPart.CFrame

			if state.desync.mode == "Destroy Cheaters" then
				state.desync.teleportCFrame = CFrame.new(11223344556677889900, 1, 1)

			elseif state.desync.mode == "Underground" then
				state.desync.teleportCFrame = CFrame.new(rootPart.Position - Vector3.new(0, 12, 0))

			elseif state.desync.mode == "Void Spam" then
				state.desync.teleportCFrame = math.random(1, 2) == 1 and state.desync.old_position or CFrame.new(
					math.random(10000, 50000),
					math.random(10000, 50000),
					math.random(10000, 50000)
				)

			elseif state.desync.mode == "Void" then
				state.desync.teleportCFrame = CFrame.new(
					rootPart.Position.X + math.random(-444444, 444444),
					rootPart.Position.Y + math.random(-444444, 444444),
					rootPart.Position.Z + math.random(-44444, 44444)
				)

			elseif state.desync.mode == "Random" then
				local offset = Vector3.new(math.random(-20, 20), math.random(-10, 10), math.random(-20, 20))
				state.desync.teleportCFrame = CFrame.new(state.desync.old_position.Position + offset) * state.desync.old_position.Rotation

			elseif state.desync.mode == "Below" then
				state.desync.teleportCFrame = CFrame.new(rootPart.Position - Vector3.new(0, 5, 0)) * CFrame.Angles(math.rad(math.random(0, 360)), math.rad(math.random(0, 360)), math.rad(180))
			end

			if state.desync.mode ~= "Rotation" then
				rootPart.CFrame = state.desync.teleportCFrame
				workspace.CurrentCamera.CameraSubject = state.desync.setbackPart

				RunService.RenderStepped:Wait()

				state.desync.setbackPart.CFrame = state.desync.old_position * CFrame.new(0, rootPart.Size.Y / 2 + 0.5, 0)
				rootPart.CFrame = state.desync.old_position
			end
		end
	end

end)

