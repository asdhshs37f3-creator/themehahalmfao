	if not hrp then
		desyncIconGui.Enabled = false
		return
	end

	local visualizeCFrame = hrp.CFrame
	if state.desync.enabled and state.desync.teleportCFrame then
		visualizeCFrame = state.desync.teleportCFrame
	end

	desyncIconGui.Enabled = true
	desyncIcon.CFrame = visualizeCFrame * CFrame.new(0, 3, 0)
end)

