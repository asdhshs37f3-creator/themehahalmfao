function utils.applyAngelAura()
	if not LocalPlayer.Character then return end
	local auraName = state.visuals.selectedAura
	if auraName == "Starlight" or auraName == "Sakura" then
		local assetIds = {Starlight = "rbxassetid://134645216613107", Sakura = "rbxassetid://81755778619404"}
		local succ, auraObj = pcall(game.GetObjects, game, assetIds[auraName])
		if not succ or not auraObj or #auraObj == 0 then return end
		auraObj = auraObj[1]
		local char = LocalPlayer.Character
		local function mapChar(c)
			local t = {}
			for _, ch in ipairs(c:GetChildren()) do if ch:IsA("BasePart") then t[ch.Name] = ch end end
			return t
		end
		local parts = mapChar(char)
		local created = {}
		for _, part in ipairs(auraObj:GetChildren()) do
			local target = parts[part.Name]
			if target then
				for _, child in ipairs(part:GetChildren()) do
					if child:IsA("ParticleEmitter") or child:IsA("Beam") or child:IsA("Trail") or child:IsA("Light") or child:IsA("Attachment") then
					local inst = child:Clone()
					inst.Name = "LarpticAuraParticle"
					inst.Parent = target
					local colorSeq = ColorSequence.new({ColorSequenceKeypoint.new(0, state.visuals.angelAuraColor), ColorSequenceKeypoint.new(1, state.visuals.angelAuraColor2)})
					local function applyProps(obj, setSize)
						if obj:IsA("ParticleEmitter") then
							obj.Color = colorSeq
							if setSize then
								obj.Size = NumberSequence.new(state.visuals.auraWidth)
								obj.Transparency = NumberSequence.new(state.visuals.auraTransparency)
							end
							obj.Enabled = true
						elseif obj:IsA("Beam") or obj:IsA("Trail") then
							obj.Color = colorSeq
						elseif obj:IsA("PointLight") then
							obj.Color = state.visuals.angelAuraColor
						elseif obj:IsA("BasePart") then
							obj.Color = state.visuals.angelAuraColor
							obj.Material = Enum.Material.Neon
						end
					end
					applyProps(inst, true)
					for _, d in ipairs(inst:GetDescendants()) do applyProps(d, false) end
					table.insert(created, inst)
					end
				end
			end
		end
		auraObj:Destroy()
		state.visuals.selfAuraParticles = created
		local model = Instance.new("Model")
		model.Name = "ParticleAura"
		model.Parent = char
		state.visuals.angelAuraModel = model
		return
	end
	local auraId = 90022969696073
	if auraName == "Halo" then
		auraId = 48291648
	end
	local model = utils.attachModel(auraId)
	if model then
		state.visuals.angelAuraModel = model
		utils.updateAngelAuraColor()
	else
		local fallback = Instance.new("Model")
		fallback.Name = "AuraFallback"
		fallback.Parent = LocalPlayer.Character
		local torso = LocalPlayer.Character:FindFirstChild("UpperTorso") or LocalPlayer.Character:FindFirstChild("Torso") or LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if torso then
			for i = 1, 12 do
				local part = Instance.new("Part")
				part.Name = "AuraPart" .. i
				part.Size = Vector3.new(0.5, 0.5, 0.5)
				part.Shape = Enum.PartType.Ball
				part.Color = state.visuals.angelAuraColor
				part.Material = Enum.Material.Neon
				part.Anchored = false
				part.CanCollide = false
				part.Parent = fallback
				local motor = Instance.new("Motor6D")
				motor.Part0 = torso
				motor.Part1 = part
				motor.C0 = CFrame.new(math.cos((i/12)*math.pi*2)*3, 0, math.sin((i/12)*math.pi*2)*3)
				motor.Parent = torso
			end
		end
		state.visuals.angelAuraModel = fallback
	end
end

