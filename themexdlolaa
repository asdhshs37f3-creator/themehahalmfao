function utils.playHitChams(player)
	if not state.visuals.hitChamsEnabled then return end
	if not player or not player.Character then return end

	local character = player.Character
	if not character:IsDescendantOf(workspace) then return end

	local hitChamsColor = state.visuals.hitChamsColor
	local hitChamsTransparency = state.visuals.hitChamsTransparency
	local hitChamsMaterial = state.visuals.hitChamsType == "forcefield" and Enum.Material.ForceField or Enum.Material.Neon
	local size = Vector3.new(1, 1, 1)

	local function destroyHitChamsNone(model)
		if model and model.Parent then
			model:Destroy()
		end
		if state.visuals.hitChamsLastModel == model then
			state.visuals.hitChamsLastModel = nil
		end
	end

	local function destroyHitChamsFade(model)
		if not model or not model.Parent then return end

		local children = model:GetDescendants()
		local elapsedTime = 0
		local heartbeatConnection

		heartbeatConnection = RunService.Heartbeat:Connect(function(dt)
			if not model or not model.Parent then
				heartbeatConnection:Disconnect()
				return
			end

			elapsedTime = elapsedTime + dt
			local progress = math.clamp(elapsedTime / 0.25, 0, 1)
			local transparency = hitChamsTransparency + (1 - hitChamsTransparency) * (1 - (1 - progress) ^ 2)

			for _, child in ipairs(children) do
				if child and child.Parent then
					if child:IsA("BasePart") or child:IsA("SelectionBox") then
						child.Transparency = transparency
					end
				end
			end

			if progress >= 1 then
				heartbeatConnection:Disconnect()
			end
		end)

		delay(0.25, function()
			if heartbeatConnection then
				heartbeatConnection:Disconnect()
			end
			if model and model.Parent then
				model:Destroy()
			end
		end)
	end

	local function destroyHitChamsNewFade(model)
		if not model or not model.Parent then return end

		local children = model:GetDescendants()
		local elapsedTime = 0
		local originalSizes = {}

		for _, child in ipairs(children) do
			if child:IsA("MeshPart") then
				originalSizes[child] = child.Size
			end
		end

		local heartbeatConnection
		heartbeatConnection = RunService.Heartbeat:Connect(function(dt)
			if not model or not model.Parent then
				heartbeatConnection:Disconnect()
				return
			end

			elapsedTime = elapsedTime + dt
			local progress = math.clamp(elapsedTime / 0.15, 0, 1)
			local transparency = hitChamsTransparency + (1 - hitChamsTransparency) * (1 - (1 - progress) ^ 2)

			for _, child in ipairs(children) do
				if child and child.Parent then
					if child:IsA("BasePart") then
						child.Transparency = transparency
						local oldSize = originalSizes[child]
						if oldSize then
							child.Size = oldSize + size * transparency
						end
					elseif child:IsA("SelectionBox") then
						child.Transparency = transparency
					end
				end
			end

			if progress >= 1 then
				heartbeatConnection:Disconnect()
			end
		end)

		delay(0.25, function()
			if heartbeatConnection then
				heartbeatConnection:Disconnect()
			end
			if model and model.Parent then
				model:Destroy()
			end
		end)
	end

	local function createHitChamsModel()
		character.Archivable = true
		local newModel = character:Clone()
		character.Archivable = false
		newModel.Name = "\0"

		for _, part in ipairs(newModel:GetDescendants()) do
			if part.ClassName == "MeshPart" then
				part.Material = hitChamsMaterial
				part.Color = hitChamsColor
				part.Transparency = hitChamsTransparency
				part.TextureID = ""
				part.CanCollide = false
				part.Anchored = true
				if part.Name == "Head" then
					local face = part:FindFirstChildOfClass("Decal")
					if face then
						face:Destroy()
					end
				end
			elseif part.ClassName == "Accessory" then
				local hat = part:FindFirstChildOfClass("MeshPart")
				if hat then
					hat.Material = hitChamsMaterial
					hat.Color = hitChamsColor
					hat.Transparency = hitChamsTransparency
					hat.TextureID = ""
					hat.CanCollide = false
					hat.Anchored = true
					hat.Parent = newModel
					part:Destroy()
				end
			else
				part:Destroy()
			end
		end

		return newModel
	end

	local function createHitChamsOutlineModel()
		character.Archivable = true
		local newModel = character:Clone()
		character.Archivable = false
		newModel.Name = "\0"

		for _, part in ipairs(newModel:GetDescendants()) do
			local isHead = part.Name == "Head"
			if isHead or part.ClassName == "MeshPart" then
				local partName = part.Name
				part.Transparency = 1
				part.CanCollide = false
				part.Anchored = true
				local outline = Instance.new("SelectionBox")
				outline.Name = partName
				outline.LineThickness = 0.01
				outline.Color3 = hitChamsColor
				outline.Transparency = hitChamsTransparency
				outline.Adornee = part
				outline.Parent = newModel
				part.Name = "\0"
				if isHead then
					local face = part:FindFirstChildOfClass("Decal")
					if face then
						face:Destroy()
					end
				end
			else
				part:Destroy()
			end
		end

		return newModel
	end

	local hitModel = state.visuals.hitChamsType == "outline" and createHitChamsOutlineModel() or createHitChamsModel()
	hitModel.Parent = workspace
	state.visuals.hitChamsLastModel = hitModel

	local destroyHitChams = destroyHitChamsNone
	if state.visuals.hitChamsAnimation == "fade" then
		destroyHitChams = destroyHitChamsFade
	elseif state.visuals.hitChamsAnimation == "new fade" then
		destroyHitChams = destroyHitChamsNewFade
	end

	task.delay(state.visuals.hitChamsLifetime, function()
		destroyHitChams(hitModel)
	end)
end

function utils.clearHitTracking(player)
	if not player then return end

	local connections = state.misc.hitHealthConnections[player]
	if connections then
		for _, conn in ipairs(connections) do
			if conn and conn.Disconnect then
				pcall(conn.Disconnect, conn)
			end
		end
		state.misc.hitHealthConnections[player] = nil
	end
end

function utils.bindPlayerHumanoid(player, humanoid)
	if not player or not humanoid then return end

	utils.clearHitTracking(player)
	state.misc.hitHealthConnections[player] = state.misc.hitHealthConnections[player] or {}
	state.misc.previousHealth[player] = humanoid.Health

	local conn = humanoid.HealthChanged:Connect(function(newHealth)
		local previousHealth = state.misc.previousHealth[player]
		if previousHealth and newHealth < previousHealth then
			if state.misc.lastShotTargets[player.UserId] and (tick() - state.misc.lastShotTargets[player.UserId]) <= state.misc.shotConfirmDuration then
				utils.playHitChams(player)
				utils.playHitSound(player)
			end
		end
		state.misc.previousHealth[player] = newHealth
	end)

	state.misc.hitHealthConnections[player][#state.misc.hitHealthConnections[player] + 1] = conn
end

function utils.setupHitTracking(player)
	if not player or player == LocalPlayer then return end
	utils.clearHitTracking(player)

	local function bindCharacter(character)
		if not character then return end
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 4)
		if humanoid then
			utils.bindPlayerHumanoid(player, humanoid)
		end
	end

	if player.Character then
		bindCharacter(player.Character)
	end
	player.CharacterAdded:Connect(bindCharacter)
end

-- Nearest player to cursor
function utils.recordLocalShot()
	if UIS:GetFocusedTextBox() then return end

	local mouse = LocalPlayer:GetMouse()
	local clickedTarget = mouse.Target
	local target = false

	if clickedTarget then
		target = utils.getTriggerbotTarget(clickedTarget)
	end

	if not target then
		target = utils.getNearestToCursor()
	end

	if target and target ~= LocalPlayer then
		state.misc.lastShotTargets[target.UserId] = tick()
		task.delay(state.misc.shotConfirmDuration, function()
			if state.misc.lastShotTargets[target.UserId] and (tick() - state.misc.lastShotTargets[target.UserId]) >= state.misc.shotConfirmDuration then
				state.misc.lastShotTargets[target.UserId] = nil
			end
		end)
	end
end

UIS.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		utils.recordLocalShot()
	end
end)

function utils.getNearestToCursor()
	local mouseLocation = UIS:GetMouseLocation()
	local nearestPlayer, shortestDistance = nil, math.huge

	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local character = player.Character
			if character and character:FindFirstChild("Head") then
				local head = character.Head
				local screenPosition, onScreen = Camera:WorldToViewportPoint(head.Position)
				if onScreen then
					local distanceToCursor = (Vector2.new(screenPosition.X, screenPosition.Y) - mouseLocation).Magnitude
					if distanceToCursor < shortestDistance then
						shortestDistance = distanceToCursor
						nearestPlayer = player
					end
				end
			end
		end
	end

	return nearestPlayer
end

function utils.setupAntiStomp(character)
	if not state.movement.antiStompEnabled or not character then return end

	-- clean up existing connection
	if state.movement.antiStompConnection then
		pcall(function() state.movement.antiStompConnection:Disconnect() end)
		state.movement.antiStompConnection = nil
	end

	local bodyEffects = character:FindFirstChild("BodyEffects")
	local knockedObj = bodyEffects and (bodyEffects:FindFirstChild("K.O") or bodyEffects:FindFirstChild("KO"))
	if not knockedObj then return end

	state.movement.antiStompConnection = knockedObj:GetPropertyChangedSignal("Value"):Connect(function()
		local knocked = knockedObj.Value
		if knocked and state.movement.antiStompEnabled then
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp then
				-- save position if not in void
				if hrp.Position.Y > -100 then
					state.movement.antiStompSavedPosition = hrp.CFrame
				end

				if setnetworkowner then
					pcall(setnetworkowner, hrp, true)
				end

				pcall(function()
					hrp.CFrame = CFrame.new(0, -2147483647, 0)
					hrp.Velocity = Vector3.new(65536, 65534, 65536)
				end)
			end

			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				for i = 1, 10 do
					pcall(function() humanoid.Health = 0 end)
					task.wait()
				end
			end
		end
	end)
end

-- Auto teleport back on respawn if position saved
local function antiStompOnCharacterAdded(character)
	if state.movement.antiStompEnabled and state.movement.antiStompSavedPosition then
		local hrp = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
		if hrp then
			for i = 1, 3 do
				pcall(function() hrp.CFrame = state.movement.antiStompSavedPosition end)
				task.wait()
			end
		end
		state.movement.antiStompSavedPosition = nil
	end

	-- ensure new character is monitored
	if state.movement.antiStompEnabled then
		pcall(function() utils.setupAntiStomp(character) end)
	end
end

