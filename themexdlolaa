function utils.attachModel(assetId)
	if not LocalPlayer.Character then
		return nil
	end
	local success, result = pcall(function()
		return game:GetObjects("rbxassetid://" .. assetId)
	end)
	if not success or not result or #result == 0 then return nil end
	local model = result[1]
	if not model then return nil end
	model.Parent = LocalPlayer.Character
	local torso = LocalPlayer.Character:FindFirstChild("UpperTorso") or LocalPlayer.Character:FindFirstChild("Torso") or LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not torso then return nil end
	if model:IsA("Model") then
		for _, child in pairs(model:GetChildren()) do
			if child:IsA("BasePart") then
				child.Anchored = false
				child.CanCollide = false
				local motor = Instance.new("Motor6D")
				motor.Part0 = torso
				motor.Part1 = child
				motor.C0 = CFrame.new(0, 0, 0)
				motor.Parent = torso
			elseif child:IsA("Accessory") then
				local handle = child:FindFirstChild("Handle")
				if handle then
					handle.Anchored = false
					handle.CanCollide = false
					local motor = Instance.new("Motor6D")
					motor.Part0 = torso
					motor.Part1 = handle
					motor.C0 = CFrame.new(0, 0, 0)
					motor.Parent = torso
				end
			end
		end
	elseif model:IsA("BasePart") then
		model.Anchored = false
		model.CanCollide = false
		local motor = Instance.new("Motor6D")
		motor.Part0 = torso
		motor.Part1 = model
		motor.C0 = CFrame.new(0, 0, 0)
		motor.Parent = torso
	end
	return model
end

