		if state.animations.removeShootEnabled then
			for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
				local character = player.Character
				if character then
					utils.StopAnimationTracks(character)
				end
			end
		end
	end)
end

-- Godmode Functions
function utils.godmodeCleanup()
	local gm = state.godmode
	if gm.track then
		pcall(function() gm.track:Stop() gm.track:Destroy() end)
		gm.track = nil
	end
	if gm.heartbeatConn then
		gm.heartbeatConn:Disconnect()
		gm.heartbeatConn = nil
	end
	if gm.animConn then
		gm.animConn:Disconnect()
		gm.animConn = nil
	end
end

function utils.godmodeStart()
	if not state.godmode.enabled then return end
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChild("Humanoid") or char:WaitForChild("Humanoid", 5)
	if not hum then return end

	utils.godmodeCleanup()

	local gm = state.godmode
	local anim = Instance.new("Animation")
	anim.AnimationId = gm.emoteId
	anim.Parent = hum
	gm.track = hum:LoadAnimation(anim)
	gm.track:Play(0, 1, 1)

	task.delay(0.1, function()
		if gm.track and gm.enabled then
			gm.track.TimePosition = gm.freezeTime
			gm.track:AdjustSpeed(0)
		end
	end)

	gm.heartbeatConn = RunService.Heartbeat:Connect(function()
		if gm.track and state.godmode.enabled then
			gm.track.TimePosition = gm.freezeTime
			gm.track:AdjustSpeed(0)
		end
	end)

	gm.animConn = hum.AnimationPlayed:Connect(function(newtrack)
		if state.godmode.enabled and gm.track and newtrack ~= gm.track then
			task.delay(0.02 + math.random() * 0.03, utils.godmodeStart)
		end
	end)
end

function utils.godmodeStop()
	utils.godmodeCleanup()
end

function utils.godmodeToggle(val)
	state.godmode.enabled = val
	if val then
		utils.godmodeStart()
	else
		utils.godmodeStop()
	end
end

-- Helper to create instance with properties
local function createInstance(className, properties)
	local instance = Instance.new(className)
	for prop, val in pairs(properties) do
		instance[prop] = val
	end
	return instance
end

local function createPlayerESPContainer(player)
