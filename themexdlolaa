		Name = player.Name,
		Parent = state.visuals.espGui,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false
	})

	-- Full Box Frame
	local box = createInstance("Frame", {
		Name = "Box",
		Parent = container,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false
	})
	local boxStroke = createInstance("UIStroke", {
		Name = "Stroke",
		Parent = box,
		Thickness = 1,
		LineJoinMode = Enum.LineJoinMode.Miter
	})

	-- Box Fill Frame
	local boxFill = createInstance("Frame", {
		Name = "BoxFill",
		Parent = container,
		BackgroundTransparency = 0.7,
		BorderSizePixel = 0,
		Visible = false
	})
	local boxFillGradient = createInstance("UIGradient", {
		Name = "Gradient",
		Parent = boxFill,
		Rotation = -45,
		Enabled = false
	})


	-- Corner Lines
	local corners = createInstance("Frame", {
		Name = "Corners",
		Parent = container,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false
	})
	
	local function createCornerLine(name, parent)
		local outer = createInstance("Frame", {
			Name = name,
			Parent = parent,
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BorderSizePixel = 0
		})
		local inner = createInstance("Frame", {
			Name = "Inner",
			Parent = outer,
			BorderSizePixel = 0
		})
		return outer
	end

	createCornerLine("LT_H", corners)
	createCornerLine("LT_V", corners)
	createCornerLine("RT_H", corners)
	createCornerLine("RT_V", corners)
	createCornerLine("LB_H", corners)
	createCornerLine("LB_V", corners)
	createCornerLine("RB_H", corners)
	createCornerLine("RB_V", corners)

	-- Health bar BG & Active
