-- Spread 
utils.originalRandom = hookfunction(math.random, function(...)
	local args = {...}
	if checkcaller() then
		return utils.originalRandom(...)
	end
	if
		(#args == 0)
		or (args[1] == -0.05 and args[2] == 0.05)
		or (args[1] == -0.1)
		or (args[1] == -0.05)
	then
		if state.spread.enabled then
			return utils.originalRandom(...) * (state.spread.amount / 100)
		end
	end
	return utils.originalRandom(...)
end)

-- Combat helper functions
function utils.isPlayerKnockedOut(player)
	local char = player.Character
	if not char then return true end
	local hum = char:FindFirstChild("Humanoid")
	local bodyEffects = char:FindFirstChild("BodyEffects")
	if hum and hum.Health <= 15 then return true end
	if bodyEffects then
		local ko = bodyEffects:FindFirstChild("K.O") or bodyEffects:FindFirstChild("KO")
		if ko and ko.Value then return true end
	end
	return false
end

function utils.isPlayerDead(player)
	local char = player.Character
	if not char then return true end
	local hum = char:FindFirstChild("Humanoid")
	if hum and hum.Health <= 0 then return true end
	return false
end

function utils.checkDistance(startPos, endPos)
	return (endPos - startPos).Magnitude <= state.camlock.maxShootDistance
end

function utils.checkObstacles(startPos, endPos, ignore)
	local ray = Ray.new(startPos, (endPos - startPos).Unit * (endPos - startPos).Magnitude)
	local hit, hitPos = workspace:FindPartOnRayWithIgnoreList(ray, ignore)
	if hit and hitPos then
		return (hitPos - startPos).Magnitude < (endPos - startPos).Magnitude
	end
	return false
end

function utils.isOnScreen(position)
	local pos, onScreen = Camera:WorldToViewportPoint(position)
	return onScreen
end

function utils.getFOV(position)
	local pos, onScreen = Camera:WorldToViewportPoint(position)
	if not onScreen then return math.huge end
	local mag = (Vector2.new(pos.X, pos.Y) - Camera.ViewportSize / 2).Magnitude
	return mag
end

function utils.isSameTeam(player1, player2)
	if not player1 or not player2 then return false end
	local team1 = player1.Team
	local team2 = player2.Team
	return team1 and team2 and team1 == team2
end

function utils.isWithinDistance(position, maxDist)
	local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not myHRP then return false end
	local dist = (position - myHRP.Position).Magnitude
	return dist <= maxDist
end

function utils.predictPosition(targetRoot, predictionMultiplier)
	if not targetRoot then return targetRoot.Position end
	if targetRoot.Velocity.Magnitude > 700 then
		return targetRoot.Position
	end
	return targetRoot.Position + (targetRoot.Velocity * predictionMultiplier)
end

function utils.GetClosestPlayer()
	local mouseLocation = UIS:GetMouseLocation()
	local closest, dist = nil, math.huge
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			-- Team check
			if state.camlock.teamCheck and utils.isSameTeam(LocalPlayer, player) then
				continue
			end
			if getgenv().Whitelist and getgenv().Whitelist[player.Name] then
				continue
			end
			
			local pos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
			if onScreen then
				local mag = (Vector2.new(pos.X, pos.Y) - mouseLocation).Magnitude
				
				if state.camlock.fovCheck then
					local fovRadius = (Camera.ViewportSize.X / 2) * math.tan(math.rad(state.camlock.fov) / 2)
					if mag > fovRadius then
						continue
					end
				end
				
				if mag < dist then
					closest, dist = player, mag
				end
			end
		end
	end
	return closest
end

