-- Triggerbot Functions
local KNIFE_NAMES = {"[Knife]", "Knife", "Fists", "[Fists]", "Baseball Bat", "[Baseball Bat]", "Crowbar", "[Crowbar]", "Bat", "[Bat]", "Hammer", "[Hammer]"}

function utils.isKnife(tool)
	for _, name in ipairs(KNIFE_NAMES) do
		if tool.Name == name then return true end
	end
	return false
end

function utils.isToolBlacklisted(tool)
	for _, toolName in ipairs(state.triggerbot.blacklisted) do
		if tool.Name == toolName then
			return true
		end
	end
	return false
end

function utils.getTriggerbotTarget(instance)
	if not instance then return false end

	for _, player in pairs(Players:GetPlayers()) do
		if player.Character and (instance == player.Character or instance:IsDescendantOf(player.Character)) then
			if not utils.isPlayerKnockedOut(player) then
				return player
			end
		end
	end

	return false
end

function utils.updateTriggerbot()
	if state.triggerbot.enabled and LocalPlayer.Character then
		local mouse_obj = LocalPlayer:GetMouse()
		local target = mouse_obj.Target

		if target and utils.getTriggerbotTarget(target) then
			local tool = LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
			if tool and not utils.isToolBlacklisted(tool) then
				local mode = state.triggerbot.checkMode
				if mode == "Knife Check" then
					if utils.isKnife(tool) then return end
				elseif mode == "Team Check" then
					local targetPlayer = utils.getTriggerbotTarget(target)
					if targetPlayer and utils.isSameTeam(LocalPlayer, targetPlayer) then return end
				end
				task.wait(state.triggerbot.delay)
				tool:Activate()
			end
		end
	end
end

