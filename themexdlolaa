function utils.getForcehitTarget()
	local mouseLocation = UIS:GetMouseLocation()
	local closest, dist = nil, math.huge
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
			if state.camlock.teamCheck and utils.isSameTeam(LocalPlayer, player) then continue end
			if getgenv().Whitelist and getgenv().Whitelist[player.Name] then continue end
			local pos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
			if onScreen then
				local mag = (Vector2.new(pos.X, pos.Y) - mouseLocation).Magnitude
				if mag < dist then
					closest, dist = player, mag
				end
			end
		end
	end
	return closest
end

function utils.drawForcehitTracer(target)
	if not target or not target.Character or not target.Character:FindFirstChild("Head") then
		utils.clearForcehitTracer()
		return
	end
	local head = target.Character.Head
	local headPos, onScreen = Camera:WorldToViewportPoint(head.Position)
	if not onScreen then
		utils.clearForcehitTracer()
		return
	end
	if not state.camlock.forcehitTracerEnabled then
		utils.clearForcehitTracer()
		return
	end
	local tracer = state.camlock.forcehitTracer
	if not tracer then
		tracer = Drawing.new("Line")
		tracer.Thickness = 2
		state.camlock.forcehitTracer = tracer
	end
	tracer.Color = state.camlock.forcehitTracerColor
	tracer.From = UIS:GetMouseLocation()
	tracer.To = Vector2.new(headPos.X, headPos.Y)
	tracer.Visible = true
end

function utils.clearForcehitTracer()
	if state.camlock.forcehitTracer then
		state.camlock.forcehitTracer.Visible = false
		state.camlock.forcehitTracer:Remove()
		state.camlock.forcehitTracer = nil
	end
end

function utils.addPreviewHighlight(player)
	if not state.camlock.highlightsEnabled then return end

	if state.camlock.previewHighlight and state.camlock.previewHighlight.Parent == player.Character then
		return
	end

	if state.camlock.previewHighlight then
		state.camlock.previewHighlight:Destroy()
	end

	if player and player.Character then
		state.camlock.previewHighlight = Instance.new("Highlight")
		state.camlock.previewHighlight.Parent = player.Character
		state.camlock.previewHighlight.FillTransparency = 0.5
		state.camlock.previewHighlight.FillColor = Color3.fromRGB(255, 255, 255)
	end
end

function utils.addLockedHighlight(player)
