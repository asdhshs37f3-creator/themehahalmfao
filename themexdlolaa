				},
				[2] = {
					[1] = {thePart = Head, theOffset = Vector3.new()},
					[2] = {thePart = Head, theOffset = Vector3.new()},
					[3] = {thePart = Head, theOffset = Vector3.new()},
					[4] = {thePart = Head, theOffset = Vector3.new()},
					[5] = {thePart = Head, theOffset = Vector3.new()},
				},
				[3] = fakeRoot,
				[4] = fakeRoot,
				[5] = workspace:GetServerTimeNow(),
			}
		}
		MainEvent:FireServer(unpack(args))
		MainEvent:FireServer(unpack(args))
	else
		local args = {
			[1] = "Shoot",
			[2] = {
				[1] = {
					[1] = {Normal = Head.Position, Instance = Head, Position = Head.Position},
					[2] = {Normal = Head.Position, Instance = Head, Position = Head.Position},
					[3] = {Normal = Head.Position, Instance = Head, Position = Head.Position},
					[4] = {Normal = Head.Position, Instance = Head, Position = Head.Position},
					[5] = {Normal = Head.Position, Instance = Head, Position = Head.Position},
				},
				[2] = {
					[1] = {thePart = Head, theOffset = Vector3.new()},
					[2] = {thePart = Head, theOffset = Vector3.new()},
					[3] = {thePart = Head, theOffset = Vector3.new()},
