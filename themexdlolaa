local function updateIndicator()
	if not state.camlock.indicatorEnabled or not IndicatorUI then
		if IndicatorUI then
			IndicatorUI.Enabled = false
		end
		return
	end

	local Plr = state.camlock.target
	if state.camlock.enabled and Plr and Plr.Character then
		IndicatorUI.Enabled = true

		local humanoid = Plr.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
			if HealthBarValue then
				HealthBarValue.Size = UDim2.new(healthPercent, 0, 1, 0)
				-- Color thresholds: low (<=33%) = red, mid (<=66%) = orange, high = green
				local barColor
				if healthPercent <= 0.33 then
					barColor = Color3.fromRGB(195, 50, 50) -- low red
				elseif healthPercent <= 0.66 then
					barColor = Color3.fromRGB(255, 153, 28) -- mid orange #FF991C
				else
					barColor = Color3.fromRGB(45, 195, 45) -- high green (default)
				end
				HealthBarValue.BackgroundColor3 = barColor
				-- Update any UIGradient on the health bar to match the color
				for _, child in pairs(HealthBarValue:GetChildren()) do
					if child:IsA("UIGradient") then
						child.Color = ColorSequence.new{
							ColorSequenceKeypoint.new(0, barColor),
							ColorSequenceKeypoint.new(1, barColor:Lerp(Color3.new(0, 0, 0), 0.35))
						}
					end
				end
			end
			if IndicatorHealthText then
				IndicatorHealthText.Text = math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth)
			end

			if PlayerIcon then
				PlayerIcon.Image = "rbxthumb://type=AvatarHeadShot&id=" .. Plr.UserId .. "&w=420&h=420"
			end

			if NameLabel then
				NameLabel.Text = Plr.Name
			end

			if DistanceLabel then
				if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and Plr.Character:FindFirstChild("HumanoidRootPart") then
					local distance = (LocalPlayer.Character.HumanoidRootPart.Position - Plr.Character.HumanoidRootPart.Position).Magnitude
					DistanceLabel.Text = math.floor(distance) .. " studs"
				else
					DistanceLabel.Text = "N/A studs"
				end
			end

			if ArmorFrame then
				local armor = Plr.Character:FindFirstChild("BodyEffects") and Plr.Character.BodyEffects:FindFirstChild("Armor")
				if armor then
					ArmorFrame.Visible = true
					local armorValue = armor.Value
					local armorPercent = math.clamp(armorValue / 100, 0, 1)
					if ArmorBarValue then
						ArmorBarValue.Size = UDim2.new(armorPercent, 0, 1, 0)
					end
					if ArmorText then
						ArmorText.Text = math.floor(armorValue) .. "/100"
					end
				else
					ArmorFrame.Visible = false
				end
			end
		end
	else
		if IndicatorUI then
			IndicatorUI.Enabled = false
		end
	end
end

