audioUpdateConnection = RunService.RenderStepped:Connect(function()
	if not audioSound then return end

	-- Time display & progress bar
	if state.audio.isPlaying and audioSound.TimeLength > 0 then
		local pos = math.floor(audioSound.TimePosition)
		local len = math.floor(audioSound.TimeLength)
		local posMin, posSec = math.floor(pos / 60), pos % 60
		local lenMin, lenSec = math.floor(len / 60), len % 60
		if AudioTimeLabel then
			AudioTimeLabel.Text = string.format("%02d:%02d / %02d:%02d", posMin, posSec, lenMin, lenSec)
		end
		if state.audio._progressFill and audioSound.TimeLength > 0 then
			local pct = math.clamp(audioSound.TimePosition / audioSound.TimeLength, 0, 1)
			state.audio._progressFill.Size = UDim2.new(pct, 0, 1, 0)
		end
	elseif AudioTimeLabel and not state.audio.isPlaying then
		AudioTimeLabel.Text = "00:00 / 00:00"
	end

	-- Disc pulse animation
	if state.audio._discLabel then
		if state.audio.isPlaying then
			local loudness = audioSound.PlaybackLoudness or 0
			local pulse = 1 + math.clamp(loudness / 1200, 0, 0.18)
			state.audio._discLabel.TextSize = math.floor(52 * pulse)
		end
	end

	-- Equalizer Visualizer animation
	if state.audio.visualizerEnabled and AudioVisualizerContainer and AudioVisualizerContainer.Visible then
		local loudness = audioSound.PlaybackLoudness or 0
		local loudnessFactor = state.audio.isPlaying and math.clamp(loudness / 350, 0.05, 1) or 0.04
		local t = tick()
		local bars = state.audio.visualizerBars
		local count = #bars
		for i, barData in ipairs(bars) do
			local wave = math.abs(math.sin(t * 14 + i * 0.45) * 0.4 + math.cos(t * 9 - i * 0.3) * 0.35 + 0.25)
			local targetHeight = state.audio.isPlaying and math.clamp(wave * loudnessFactor * 0.95 + 0.05, 0.05, 0.95) or 0.04
			barData.currentHeight = barData.currentHeight + (targetHeight - barData.currentHeight) * 0.35
			barData.frame.Size = UDim2.new(1 / count - 0.025, 0, barData.currentHeight, 0)
		end
	end
end)

local function updateIndicator()
	if not state.camlock.indicatorEnabled or not IndicatorUI then
		if IndicatorUI then
			IndicatorUI.Enabled = false
		end
		return
	end

	local Plr = state.camlock.target
	if state.camlock.enabled and Plr and Plr.Character then
		IndicatorUI.Enabled = true

		local humanoid = Plr.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
			if HealthBarValue then
				HealthBarValue.Size = UDim2.new(healthPercent, 0, 1, 0)
				local barColor
				if healthPercent <= 0.33 then
					barColor = Color3.fromRGB(195, 50, 50)
				elseif healthPercent <= 0.66 then
					barColor = Color3.fromRGB(255, 153, 28)
				else
					barColor = Color3.fromRGB(45, 195, 45)
				end
				HealthBarValue.BackgroundColor3 = barColor
				for _, child in pairs(HealthBarValue:GetChildren()) do
					if child:IsA("UIGradient") then
						child.Color = ColorSequence.new{
							ColorSequenceKeypoint.new(0, barColor),
							ColorSequenceKeypoint.new(1, barColor:Lerp(Color3.new(0, 0, 0), 0.35))
						}
					end
				end
			end
			if IndicatorHealthText then
				IndicatorHealthText.Text = math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth)
			end

			if PlayerIcon then
				PlayerIcon.Image = "rbxthumb://type=AvatarHeadShot&id=" .. Plr.UserId .. "&w=420&h=420"
			end

			if NameLabel then
				NameLabel.Text = Plr.Name
			end

			if DistanceLabel then
				if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and Plr.Character:FindFirstChild("HumanoidRootPart") then
					local distance = (LocalPlayer.Character.HumanoidRootPart.Position - Plr.Character.HumanoidRootPart.Position).Magnitude
					DistanceLabel.Text = math.floor(distance) .. " studs"
				else
					DistanceLabel.Text = "N/A studs"
				end
			end

			if ArmorFrame then
				local armor = Plr.Character:FindFirstChild("BodyEffects") and Plr.Character.BodyEffects:FindFirstChild("Armor")
				if armor then
					ArmorFrame.Visible = true
					local armorValue = armor.Value
					local armorPercent = math.clamp(armorValue / 100, 0, 1)
					if ArmorBarValue then
						ArmorBarValue.Size = UDim2.new(armorPercent, 0, 1, 0)
					end
					if ArmorText then
						ArmorText.Text = math.floor(armorValue) .. "/100"
					end
				else
					ArmorFrame.Visible = false
				end
			end
		end
	else
		if IndicatorUI then
			IndicatorUI.Enabled = false
		end
	end
end

