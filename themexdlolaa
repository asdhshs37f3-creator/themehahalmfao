	character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("AnimationTrack") and state.animations.removeShootEnabled then
			if state.animations.ids[descendant.Animation.AnimationId] then
				descendant:Stop()
			end
		end
	end)
end

function utils.MonitorPlayers()
	for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
		local character = player.Character or player.CharacterAdded:Wait()
		utils.StopAnimationTracks(character)
		utils.MonitorCharacter(character)

		player.CharacterAdded:Connect(function(newCharacter)
			utils.StopAnimationTracks(newCharacter)
			utils.MonitorCharacter(newCharacter)
		end)
	end

	game:GetService("Players").PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(character)
			utils.StopAnimationTracks(character)
			utils.MonitorCharacter(character)
		end)
	end)
