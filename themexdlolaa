function utils.updatePlayerESP(player)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	local container = state.visuals.espContainers[player] or createPlayerESPContainer(player)
	
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	
	local teamCheckEnabled = library.flags["ESP_TeamCheck"]
	local isTeammate = teamCheckEnabled and player.Team == LocalPlayer.Team
	
	if not hrp or not humanoid or humanoid.Health <= 0 or isTeammate then
		container.Visible = false
		return
	end

	local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)
	if not onScreen or pos.Z <= 0 then
		container.Visible = false
		return
	end

	local scaleFactor = (hrp.Size.Y * camera.ViewportSize.Y) / (pos.Z * 2)
	local w = (3 * scaleFactor) * 0.7
	local h = (4.5 * scaleFactor) * 0.9

	container.Visible = true

	-- 1. Boxes
	local boxesEnabled = library.flags["Boxes"]
	local boxType = library.flags["Box_Type"] or "Corner"
	local boxColor = library.flags["Box_Color"] and library.flags["Box_Color"].Color or Color3.fromRGB(88, 113, 163)
	
	local boxFillEnabled = library.flags["Box_Fill"]
	local boxFillColor = library.flags["Box_Fill_Color"] and library.flags["Box_Fill_Color"].Color or Color3.fromRGB(0, 0, 0)
	local boxFillTransparency = 0.5
	local boxGradientFill = library.flags["Box_Gradient_Fill"]
	local boxGradientFillRGB1 = library.flags["Box_Gradient_Fill_RGB_1"] and library.flags["Box_Gradient_Fill_RGB_1"].Color or Color3.fromRGB(88, 113, 163)
	local boxGradientFillRGB2 = library.flags["Box_Gradient_Fill_RGB_2"] and library.flags["Box_Gradient_Fill_RGB_2"].Color or Color3.fromRGB(0, 0, 0)


	local boxFrame = container:FindFirstChild("Box")
	local boxFillFrame = container:FindFirstChild("BoxFill")
	local cornersFrame = container:FindFirstChild("Corners")

	if boxesEnabled then
		if boxType == "Full" then
			boxFrame.Visible = true
			cornersFrame.Visible = false
			
			boxFrame.Position = UDim2.fromOffset(pos.X - w / 2, pos.Y - h / 2)
			boxFrame.Size = UDim2.fromOffset(w, h)
			boxFrame.Stroke.Color = boxColor
		else
			boxFrame.Visible = false
			cornersFrame.Visible = true

			local function setLine(line, posX, posY, sizeX, sizeY, innerX, innerY, innerSizeX, innerSizeY)
				line.Position = UDim2.fromOffset(posX, posY)
				line.Size = UDim2.fromOffset(sizeX, sizeY)
				
				local inner = line:FindFirstChild("Inner")
				if inner then
					inner.Position = UDim2.fromOffset(innerX, innerY)
					inner.Size = UDim2.fromOffset(innerSizeX, innerSizeY)
					inner.BackgroundColor3 = boxColor
				end
			end

			-- LT
			setLine(cornersFrame.LT_H, pos.X - w / 2, pos.Y - h / 2, w / 5, 3, 1, 1, w / 5 - 2, 1)
			setLine(cornersFrame.LT_V, pos.X - w / 2, pos.Y - h / 2, 3, h / 5, 1, 1, 1, h / 5 - 2)
			
			-- RT
			setLine(cornersFrame.RT_H, pos.X + w / 2 - w / 5, pos.Y - h / 2, w / 5, 3, 1, 1, w / 5 - 2, 1)
			setLine(cornersFrame.RT_V, pos.X + w / 2 - 3, pos.Y - h / 2, 3, h / 5, 1, 1, 1, h / 5 - 2)
			
			-- LB
			setLine(cornersFrame.LB_H, pos.X - w / 2, pos.Y + h / 2 - 3, w / 5, 3, 1, 1, w / 5 - 2, 1)
			setLine(cornersFrame.LB_V, pos.X - w / 2, pos.Y + h / 2 - h / 5, 3, h / 5, 1, 1, 1, h / 5 - 2)
			
			-- RB
			setLine(cornersFrame.RB_H, pos.X + w / 2 - w / 5, pos.Y + h / 2 - 3, w / 5, 3, 1, 1, w / 5 - 2, 1)
			setLine(cornersFrame.RB_V, pos.X + w / 2 - 3, pos.Y + h / 2 - h / 5, 3, h / 5, 1, 1, 1, h / 5 - 2)
		end
	else
		boxFrame.Visible = false
		cornersFrame.Visible = false
	end

	if boxFillEnabled then
		boxFillFrame.Visible = true
		boxFillFrame.Position = UDim2.fromOffset(pos.X - w / 2, pos.Y - h / 2)
		boxFillFrame.Size = UDim2.fromOffset(w, h)
		
		boxFillFrame.BackgroundTransparency = boxFillTransparency
		local gradient = boxFillFrame:FindFirstChild("Gradient")
		
		if boxGradientFill then
			boxFillFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			if gradient then
				gradient.Enabled = true
				gradient.Color = ColorSequence.new{
					ColorSequenceKeypoint.new(0, boxGradientFillRGB1),
					ColorSequenceKeypoint.new(1, boxGradientFillRGB2)
				}
			end
		else
			boxFillFrame.BackgroundColor3 = boxFillColor
			if gradient then
				gradient.Enabled = false
			end
		end
	else
		boxFillFrame.Visible = false
	end

	-- 2. Names
	local namesEnabled = library.flags["Names"]
	local nameColor = library.flags["Name_Color"] and library.flags["Name_Color"].Color or Color3.fromRGB(255, 255, 255)
	local nameLabel = container:FindFirstChild("NameLabel")

	if namesEnabled then
		nameLabel.Visible = true
		nameLabel.TextColor3 = nameColor
		nameLabel.Text = player.DisplayName or player.Name
		nameLabel.Position = UDim2.fromOffset(pos.X, pos.Y - h / 2 - 14)
	else
		nameLabel.Visible = false
	end

	-- 3. Health bar
	local healthbarEnabled = library.flags["Healthbar"]
	local healthBG = container:FindFirstChild("HealthbarBG")
	
	if healthbarEnabled then
		healthBG.Visible = true
		healthBG.Position = UDim2.fromOffset(pos.X - w / 2 - 6, pos.Y - h / 2)
		healthBG.Size = UDim2.fromOffset(4, h)
		
		local healthRatio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
		local highColor = library.flags["Health_High"] and library.flags["Health_High"].Color or Color3.fromRGB(0, 255, 0)
		local lowColor = library.flags["Health_Low"] and library.flags["Health_Low"].Color or Color3.fromRGB(255, 0, 0)
		local lerpedColor = lowColor:Lerp(highColor, healthRatio)
		
		local active = healthBG:FindFirstChild("Active")
		active.Position = UDim2.new(0, 1, 1 - healthRatio, 1)
		active.Size = UDim2.new(1, -2, healthRatio, -2)
		active.BackgroundColor3 = lerpedColor
	else
		healthBG.Visible = false
	end

	local bottomOffset = 2

	-- 4. Distance
	local distanceEnabled = library.flags["Distance"]
	local distanceColor = library.flags["Distance_Color"] and library.flags["Distance_Color"].Color or Color3.fromRGB(255, 255, 255)
	local distLabel = container:FindFirstChild("DistLabel")

	if distanceEnabled then
		distLabel.Visible = true
		distLabel.TextColor3 = distanceColor
		
		local localHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		local distStuds = localHRP and (hrp.Position - localHRP.Position).Magnitude or 0
		local distMeters = math.floor(distStuds / 3.5714285714)
		
		distLabel.Text = tostring(distMeters) .. "m"
		distLabel.Position = UDim2.fromOffset(pos.X, pos.Y + h / 2 + bottomOffset)
		bottomOffset = bottomOffset + 12
	else
		distLabel.Visible = false
	end

	-- 5. Weapon
	local weaponEnabled = library.flags["Weapon"]
	local weaponColor = library.flags["Weapon_Color"] and library.flags["Weapon_Color"].Color or Color3.fromRGB(255, 255, 255)
	local weaponLabel = container:FindFirstChild("WeaponLabel")

	if weaponEnabled then
		weaponLabel.Visible = true
		weaponLabel.TextColor3 = weaponColor
		
		local activeTool = character:FindFirstChildOfClass("Tool")
		weaponLabel.Text = activeTool and activeTool.Name or "none"
		weaponLabel.Position = UDim2.fromOffset(pos.X, pos.Y + h / 2 + bottomOffset)
	else
		weaponLabel.Visible = false
	end
end

