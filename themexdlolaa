local utils = {}

function utils.UpdateFOV(Radius)
	local fovInstance = getgenv().Silent.FOVInstance
	if not fovInstance then
		return
	end

	fovInstance.Position = Vector2.new(LocalPlayer:GetMouse().X, LocalPlayer:GetMouse().Y + Inset)
	fovInstance.Visible = getgenv().Silent.Setting.FOV["Visible"]
	fovInstance.Radius = (Radius) * 3.067

	return fovInstance
end

task.spawn(function()
	while task.wait() do
		utils.UpdateFOV(getgenv().Silent.Setting.FOV["Radius"])
	end
end)

