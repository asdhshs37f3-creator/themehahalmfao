-- Trail Functions
function utils.updateTrail(stateVal)
	local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")

	if stateVal then
		if humanoidRootPart and not humanoidRootPart:FindFirstChild("BlaBla") then
			local attachment0 = Instance.new("Attachment", humanoidRootPart)
			attachment0.Name = "Attachment0"
			attachment0.Position = Vector3.new(0, 0, 1)

			local attachment1 = Instance.new("Attachment", humanoidRootPart)
			attachment1.Name = "Attachment1"
			attachment1.Position = Vector3.new(0, 0, -1)

			local trail = Instance.new("Trail", humanoidRootPart)
			trail.Name = "BlaBla"
			trail.Attachment0 = attachment0
			trail.Attachment1 = attachment1
			trail.Color = ColorSequence.new(state.visuals.trailColor, state.visuals.trailColor2)
			trail.Lifetime = state.visuals.trailLifetime
			trail.Transparency = NumberSequence.new(0, 0)
			trail.LightEmission = 0.2
			trail.Brightness = 10
			trail.WidthScale = NumberSequence.new{
				NumberSequenceKeypoint.new(0, state.visuals.trailWidth),
				NumberSequenceKeypoint.new(1, 0)
			}
		end
	else
		if humanoidRootPart then
			for _, child in ipairs(humanoidRootPart:GetChildren()) do
				if child:IsA("Trail") and child.Name == "BlaBla" then
					child:Destroy()
				end
			end
			for _, child in ipairs(humanoidRootPart:GetChildren()) do
				if child:IsA("Attachment") and (child.Name == "Attachment0" or child.Name == "Attachment1") then
					child:Destroy()
				end
			end
		end
	end
end

