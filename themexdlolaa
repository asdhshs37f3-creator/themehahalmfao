-- Hitbox Expander Functions
function utils.getOutline(part)
	local outline = part:FindFirstChild("Outline")
	if not outline then
		outline = #state.visuals.outlinePool > 0 and table.remove(state.visuals.outlinePool) or Instance.new("SelectionBox")
		outline.LineThickness = 0.05
		outline.Color3 = state.visuals.outlineColor
		outline.Name = "Outline"
	end
	outline.Adornee = part
	outline.Parent = part
	outline.Transparency = state.visuals.outlineTransparency
	return outline
end

function utils.releaseOutline(outline)
	outline.Adornee = nil
	outline.Parent = nil
	table.insert(state.visuals.outlinePool, outline)
end

function utils.updateHitboxes()
	local now = tick()
	if now - state.visuals.lastHitboxUpdate < 0.2 then
		return
	end
	state.visuals.lastHitboxUpdate = now

	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local character = player.Character
			if character then
				local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
				if humanoidRootPart then
					local bodyEffects = character:FindFirstChild("BodyEffects")
					local isKOd = bodyEffects and bodyEffects:FindFirstChild("K.O") and bodyEffects["K.O"].Value
					local isGrabbed = character:FindFirstChild("GRABBING_CONSTRAINT") ~= nil

					if isKOd or isGrabbed then
						if humanoidRootPart.Size ~= Vector3.new(0, 0, 0) then
							humanoidRootPart.Size = Vector3.new(0, 0, 0)
							humanoidRootPart.Transparency = 1
							local outline = humanoidRootPart:FindFirstChild("Outline")
							if outline then utils.releaseOutline(outline) end
						end
					else
						local targetSize = Vector3.new(state.visuals.hitboxSize, state.visuals.hitboxSize, state.visuals.hitboxSize)
						if humanoidRootPart.Size ~= targetSize then
							humanoidRootPart.Size = targetSize
							humanoidRootPart.Material = Enum.Material.Neon
							humanoidRootPart.CanCollide = false
							utils.getOutline(humanoidRootPart)
						end
						humanoidRootPart.Transparency = state.visuals.hitboxTransparency
						humanoidRootPart.BrickColor = BrickColor.new(state.visuals.hitboxColor)

						local outline = humanoidRootPart:FindFirstChild("Outline")
						if outline then
							outline.Color3 = state.visuals.outlineColor
							outline.Transparency = state.visuals.outlineTransparency
						end
					end
				end
			end
		end
	end
end

function utils.resetHitboxes()
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local character = player.Character
			if character then
				local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
				if humanoidRootPart then
					humanoidRootPart.Size = Vector3.new(2, 2, 1)
					humanoidRootPart.Transparency = 1
					local outline = humanoidRootPart:FindFirstChild("Outline")
					if outline then utils.releaseOutline(outline) end
				end
