local function applyCustomAnimations(character)
	if not character then return end
	local animate = character:FindFirstChild("Animate")
	if not animate then return end
	pcall(function()
		local Cloned = animate:Clone()
		local idle = Cloned:FindFirstChild("idle")
		if idle then
			local a1 = idle:FindFirstChild("Animation1")
			if a1 then a1.AnimationId = ANIM_OPTIONS.Idle1 end
			local a2 = idle:FindFirstChild("Animation2")
			if a2 then a2.AnimationId = ANIM_OPTIONS.Idle2 end
		end
		local walk = Cloned:FindFirstChild("walk")
		if walk then local a = walk:FindFirstChild("WalkAnim") if a then a.AnimationId = ANIM_OPTIONS.Walk end end
		local run = Cloned:FindFirstChild("run")
		if run then local a = run:FindFirstChild("RunAnim") if a then a.AnimationId = ANIM_OPTIONS.Run end end
		local jump = Cloned:FindFirstChild("jump")
		if jump then local a = jump:FindFirstChild("JumpAnim") if a then a.AnimationId = ANIM_OPTIONS.Jump end end
		local climb = Cloned:FindFirstChild("climb")
		if climb then local a = climb:FindFirstChild("ClimbAnim") if a then a.AnimationId = ANIM_OPTIONS.Climb end end
		local fall = Cloned:FindFirstChild("fall")
		if fall then local a = fall:FindFirstChild("FallAnim") if a then a.AnimationId = ANIM_OPTIONS.Fall end end
		animate:Destroy()
		Cloned.Parent = character
	end)
end

local function updateAnimation(key, id)
	if id == "None" then return end
	ANIM_OPTIONS[key] = "rbxassetid://" .. id
	if LocalPlayer.Character then
