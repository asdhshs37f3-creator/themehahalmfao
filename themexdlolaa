function utils.updateChams()
	utils.resetChams()
	
	if not state.visuals.chamsEnabled then
		return
	end
	
	local parentGui = gethui and gethui() or CoreGui
	
	if state.visuals.chamsType == "Highlight" then
		for _, player in pairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local character = player.Character
				
				local highlight = Instance.new("Highlight")
				highlight.Name = "ChamsHighlight"
				highlight.FillColor = state.visuals.chamsColor
				highlight.OutlineColor = state.visuals.chamsOutlineColor
				highlight.FillTransparency = state.visuals.chamsTransparency
				highlight.OutlineTransparency = state.visuals.chamsTransparency
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.Adornee = character
				highlight.Parent = parentGui
				
				state.visuals.chamsAdornments[player] = {highlight}
			end
		end
	else
		local chams_z_index = 1
		local outline_offset = Vector3.new(0.05, 0.05, 0.05)
		
		for _, player in pairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local character = player.Character
				
				local chams = {}
				local culling_mode = Enum.AdornCullingMode.Automatic
				
				for i = 1, #body_parts do
					local part_name = body_parts[i]
					local character_part = character:FindFirstChild(part_name)
					
					if character_part and character_part:IsA("BasePart") then
						-- Fill layer
						chams[#chams+1] = Instance.new("BoxHandleAdornment")
						chams[#chams].Visible = true
						chams[#chams].Adornee = character_part
						chams[#chams].Transparency = state.visuals.chamsTransparency
						chams[#chams].AdornCullingMode = culling_mode
						chams[#chams].Archivable = true
						chams[#chams].Color3 = state.visuals.chamsColor
						chams[#chams].ZIndex = chams_z_index
						chams[#chams].AlwaysOnTop = true
						chams[#chams].Size = character_part.Size + chams_offset
						chams[#chams].Parent = parentGui
						
						-- Outline layer
						chams[#chams+1] = Instance.new("BoxHandleAdornment")
						chams[#chams].Visible = true
						chams[#chams].Adornee = character_part
						chams[#chams].Transparency = state.visuals.chamsTransparency
						chams[#chams].AdornCullingMode = culling_mode
						chams[#chams].Archivable = true
						chams[#chams].Color3 = state.visuals.chamsOutlineColor
						chams[#chams].ZIndex = chams_z_index
						chams[#chams].AlwaysOnTop = true
						chams[#chams].Size = character_part.Size + chams_offset + outline_offset
						chams[#chams].Parent = parentGui
					end
				end
				
				if #chams > 0 then
					state.visuals.chamsAdornments[player] = chams
				end
			end
		end
	end
end

