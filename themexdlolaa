function utils.StopAnimationTracks(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
			if state.animations.ids[track.Animation.AnimationId] then
